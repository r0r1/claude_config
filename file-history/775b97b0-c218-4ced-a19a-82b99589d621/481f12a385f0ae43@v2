module ESignature
  class OtpGeneratorService
    attr_reader :order, :user, :ip_address

    def initialize(order:, user:, ip_address: nil)
      @order = order
      @user = user
      @ip_address = ip_address
    end

    def generate_and_send
      # Check rate limiting
      return { success: false, error: 'Rate limit exceeded' } unless can_generate?

      # Generate OTP
      result = ESignature::Otp.generate_for(
        order: order,
        user: user,
        ip_address: ip_address
      )

      otp_record = result[:otp_record]
      otp_code = result[:otp_code]

      # Send OTP email asynchronously
      ESignature::OtpMailer.send_otp(
        user: user,
        order: order,
        otp_code: otp_code,
        expires_in: ESignature::Otp::OTP_VALIDITY_MINUTES
      ).deliver_later

      {
        success: true,
        otp_record: otp_record,
        message: 'OTP sent to your email'
      }
    rescue StandardError => e
      Rails.logger.error("OTP Generation Failed: #{e.message}")
      Rails.logger.error(e.backtrace.join("\n"))
      { success: false, error: 'Failed to generate OTP' }
    end

    private

    def can_generate?
      recent_otps = ESignature::Otp.where(
        order_id: order.id,
        portal_user_id: user.id
      ).where('created_at > ?', 1.hour.ago)

      recent_otps.count < ESignature::Otp::MAX_RESENDS_PER_HOUR
    end
  end
end
