            </p>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-3">
            <%= f.submit 'Verify & Sign',
                class: 'w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold',
                id: 'verify-button' %>

