require 'rails_helper'

RSpec.describe ESignature::Otp, type: :model do
  let(:order) { create(:order, form_stage: :delivery_stage) }
  let(:user) { create(:portal_user, :sales) }

  describe 'validations' do
    it { should validate_presence_of(:otp_hash) }
    it { should validate_presence_of(:expires_at) }
  end

  describe 'associations' do
    it { should belong_to(:order) }
    it { should belong_to(:portal_user) }
  end

  describe '.generate_for' do
    it 'generates a 6-digit OTP' do
      result = described_class.generate_for(order: order, user: user)
      expect(result[:otp_code]).to match(/^\d{6}$/)
    end

    it 'creates an OTP record' do
      expect {
        described_class.generate_for(order: order, user: user)
      }.to change(described_class, :count).by(1)
    end

    it 'sets expiry time to 5 minutes from now' do
      result = described_class.generate_for(order: order, user: user)
      otp_record = result[:otp_record]
      expect(otp_record.expires_at).to be_within(5.seconds).of(5.minutes.from_now)
    end

    it 'invalidates existing pending OTPs' do
      existing_otp = create(:e_signature_otp, order: order, user: user, status: :pending)
      described_class.generate_for(order: order, user: user)
      expect(existing_otp.reload.status).to eq('expired')
    end
  end

  describe '#verify' do
    let(:otp_result) { described_class.generate_for(order: order, user: user) }
    let(:otp_record) { otp_result[:otp_record] }
    let(:otp_code) { otp_result[:otp_code] }

    context 'with valid OTP' do
      it 'returns success' do
        result = otp_record.verify(otp_code)
        expect(result[:success]).to be true
      end

      it 'marks OTP as verified' do
        otp_record.verify(otp_code)
        expect(otp_record.reload.status).to eq('verified')
      end

      it 'sets verified_at timestamp' do
        otp_record.verify(otp_code)
        expect(otp_record.reload.verified_at).to be_present
      end
    end

    context 'with invalid OTP' do
      it 'returns failure' do
        result = otp_record.verify('999999')
        expect(result[:success]).to be false
        expect(result[:error]).to eq(:invalid_code)
      end

      it 'increments attempts counter' do
        expect {
          otp_record.verify('999999')
        }.to change { otp_record.reload.attempts }.by(1)
      end

      it 'locks OTP after 3 failed attempts' do
        2.times { otp_record.verify('999999') }
        expect(otp_record.reload.status).to eq('pending')

        otp_record.verify('999999')
        expect(otp_record.reload.status).to eq('locked')
      end
    end

    context 'with expired OTP' do
      before { otp_record.update(expires_at: 1.minute.ago) }

      it 'returns expired error' do
        result = otp_record.verify(otp_code)
        expect(result[:success]).to be false
        expect(result[:error]).to eq(:expired)
      end
    end
  end

  describe '#can_resend?' do
    it 'allows resend when under limit' do
      otp = create(:e_signature_otp, order: order, user: user)
      expect(otp.can_resend?).to be true
    end

    it 'denies resend when limit exceeded' do
      create_list(:e_signature_otp, 3, order: order, user: user, created_at: 30.minutes.ago)
      otp = create(:e_signature_otp, order: order, user: user)
      expect(otp.can_resend?).to be false
    end
  end
end
