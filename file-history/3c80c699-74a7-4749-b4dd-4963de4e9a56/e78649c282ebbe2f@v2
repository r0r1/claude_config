h2. Deployment Considerations

*Feature Flags:*
{code:ruby}
# Use Flipper or similar for gradual rollout
if Flipper.enabled?(:platinum_business_banners, current_user)
  # Show new banner system
else
  # Show old banner system or no banners
end
{code}

*Zero-Downtime Migration Strategy:*
# Step 1: Deploy code with new tables (banner creation disabled)
# Step 2: Backfill data if migrating from old system
# Step 3: Enable feature flag for internal users
# Step 4: Monitor performance and errors
# Step 5: Gradually roll out to all users
# Step 6: Remove feature flag and old code

*Rollback Plan:*
# Keep feature flag enabled for quick rollback
# Monitor error rates and performance metrics
# Have database backup before migration
# Document rollback steps in deployment plan

*Monitoring and Alerts:*
{code:ruby}
# config/initializers/banner_monitoring.rb
ActiveSupport::Notifications.subscribe('banner.upload') do |name, start, finish, id, payload|
  duration = finish - start

  # Send metrics to monitoring service (DataDog, New Relic, etc.)
  StatsD.increment('banner.upload.count')
  StatsD.histogram('banner.upload.duration', duration)

  if payload[:success]
    StatsD.increment('banner.upload.success')
  else
    StatsD.increment('banner.upload.failure')
    # Alert if failure rate exceeds threshold
  end
end
