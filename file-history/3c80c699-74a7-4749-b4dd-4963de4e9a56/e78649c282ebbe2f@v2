# app/validators/banner_image_validator.rb
class BannerImageValidator
  ALLOWED_CONTENT_TYPES = %w[
    image/png image/jpg image/jpeg image/gif image/webp
  ].freeze
  MAX_FILE_SIZE = 2.megabytes
  MIN_DIMENSIONS = { width: 800, height: 300 }.freeze
  RECOMMENDED_DIMENSIONS = { width: 1920, height: 600 }.freeze

  attr_reader :file, :errors

  def initialize(file)
    @file = file
    @errors = []
  end

  def valid?
    validate_presence
    validate_content_type
    validate_file_size
    validate_dimensions
    validate_file_integrity

    errors.empty?
  end

  private

  def validate_presence
    errors << 'Image file is required' if file.blank?
  end

  def validate_content_type
    return if file.blank?

    unless ALLOWED_CONTENT_TYPES.include?(file.content_type)
      errors << 'Please upload a valid image file (JPG, PNG, WebP, GIF)'
    end
  end

  def validate_file_size
    return if file.blank?

    if file.size > MAX_FILE_SIZE
      errors << 'File size must be less than 2MB. Please compress your image.'
    end
  end

  def validate_dimensions
    return if file.blank? || errors.any?

    image = MiniMagick::Image.read(file.tempfile)
    width = image.width
    height = image.height

    if width < MIN_DIMENSIONS[:width] || height < MIN_DIMENSIONS[:height]
      errors << 'Image dimensions are below minimum size (800x300px)'
    elsif width < RECOMMENDED_DIMENSIONS[:width] || height < RECOMMENDED_DIMENSIONS[:height]
      # This is a warning, not an error
      Rails.logger.warn(
        "Banner image below recommended size: #{width}x#{height}. " \
        "Recommended: #{RECOMMENDED_DIMENSIONS[:width]}x#{RECOMMENDED_DIMENSIONS[:height]}"
      )
    end
  rescue => e
    errors << 'Invalid image file'
    Rails.logger.error "Image validation error: #{e.message}"
  end

  def validate_file_integrity
    return if file.blank?

    # Check if file is actually an image by reading header
    begin
      MiniMagick::Image.read(file.tempfile)
    rescue MiniMagick::Invalid
      errors << 'File appears to be corrupted or is not a valid image'
    end
  end
end

