# app/services/banner_upload_service.rb
class BannerUploadService
  include ActiveModel::Model

  attr_accessor :banner, :image_file, :current_user

  def initialize(banner:, image_file:, current_user:)
    @banner = banner
    @image_file = image_file
    @current_user = current_user
  end

  def call
    ActiveRecord::Base.transaction do
      validate_image!
      attach_image!
      process_image!
      update_metadata!
      banner.save!

      log_upload_event

      Result.success(banner: banner)
    end
  rescue ActiveRecord::RecordInvalid => e
    Result.failure(errors: banner.errors.full_messages)
  rescue StandardError => e
    Rails.logger.error "Banner upload failed: #{e.message}"
    Result.failure(errors: ['Upload failed. Please try again.'])
  end

  private

  def validate_image!
    validator = BannerImageValidator.new(image_file)
    unless validator.valid?
      raise ActiveRecord::RecordInvalid.new(banner)
    end
  end

  def attach_image!
    banner.image.attach(image_file)
  end

  def process_image!
    BannerImageProcessorService.new(banner).call
  end

  def update_metadata!
    banner.metadata ||= {}
    banner.metadata.merge!({
      uploaded_by: current_user.id,
      uploaded_at: Time.current.iso8601,
      original_filename: image_file.original_filename,
      file_size: image_file.size,
      content_type: image_file.content_type
    })
  end

  def log_upload_event
    Rails.logger.info(
      "Banner uploaded: ID=#{banner.id}, Placement=#{banner.placement}, User=#{current_user.id}"
    )
  end

  class Result
    attr_reader :banner, :errors

    def self.success(banner:)
      new(success: true, banner: banner)
    end

    def self.failure(errors:)
      new(success: false, errors: errors)
    end

    def initialize(success:, banner: nil, errors: [])
      @success = success
      @banner = banner
      @errors = errors
    end

    def success?
      @success
    end

    def failure?
      !@success
    end
  end
end

