class BannerImageProcessorService
  def initialize(banner)
    @banner = banner
  end

  def call
    return unless @banner.image.attached?

    generate_variants
    optimize_images
    warm_cdn_cache
  end

  private

  def generate_variants
    # Pre-generate all variants to avoid on-demand processing
    [:desktop, :tablet, :mobile, :thumbnail].each do |variant_name|
      @banner.image.variant(variant_name).processed
    end
  end

  def optimize_images
    # Implement image optimization if using image processing gem
    # Example: ImageOptim, MiniMagick with optimization flags
  end

  def warm_cdn_cache
    # Pre-fetch URLs to warm CDN cache
    [:desktop, :tablet, :mobile].each do |variant|
      @banner.image_url(variant: variant)
    end
  end
