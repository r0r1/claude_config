# app/jobs/banner_activation_job.rb
class BannerActivationJob < ApplicationJob
  queue_as :default
  retry_on StandardError, wait: 5.minutes, attempts: 3

  def perform(banner_id)
    banner = Banner.find(banner_id)

    if banner.scheduled? && banner.start_date <= Time.current
      banner.activate!
      Rails.logger.info "Banner #{banner_id} activated by scheduled job"
    end
  rescue ActiveRecord::RecordNotFound
    Rails.logger.error "Banner #{banner_id} not found for activation"
  end
end

# app/jobs/banner_expiration_job.rb
class BannerExpirationJob < ApplicationJob
  queue_as :default
  retry_on StandardError, wait: 5.minutes, attempts: 3

  def perform(banner_id)
    banner = Banner.find(banner_id)

    if banner.active? && banner.end_date.present? && banner.end_date < Time.current
      banner.expire!
      Rails.logger.info "Banner #{banner_id} expired by scheduled job"
    end
  rescue ActiveRecord::RecordNotFound
    Rails.logger.error "Banner #{banner_id} not found for expiration"
  end
end

# Recurring job to clean up expired banners (optional)
# app/jobs/banner_cleanup_job.rb
class BannerCleanupJob < ApplicationJob
  queue_as :low_priority

  def perform
    # Activate scheduled banners
    Banner.scheduled_for_activation.find_each(&:activate!)

    # Expire active banners past end date
    Banner.scheduled_for_expiration.find_each(&:expire!)

    # Archive old expired banners (older than 90 days)
    Banner.where(status: :expired)
          .where('updated_at < ?', 90.days.ago)
          .find_each do |banner|
            banner.image.purge if banner.image.attached?
            banner.destroy
          end
  end
end
