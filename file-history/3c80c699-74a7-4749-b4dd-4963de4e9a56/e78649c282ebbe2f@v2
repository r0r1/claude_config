  let(:banner) { create(:banner) }

  before { sign_in admin }

  describe 'GET #index' do
    it 'returns success' do
      get :index
      expect(response).to have_http_status(:success)
    end

    it 'loads banners for specified placement' do
      banner1 = create(:banner, placement: 'platinum_business_homepage')
      banner2 = create(:banner, placement: 'ide_homepage')

      get :index, params: { placement: 'platinum_business_homepage' }
      expect(assigns(:banners)).to include(banner1)
      expect(assigns(:banners)).not_to include(banner2)
    end
  end

  describe 'POST #create' do
    let(:valid_attributes) do
      {
        title: 'Test Banner',
        alt_text: 'Test Alt Text',
        placement: 'platinum_business_homepage',
        status: 'active',
        image: fixture_file_upload('banner.jpg', 'image/jpeg')
      }
    end

    context 'with valid parameters' do
      it 'creates a new banner' do
        expect {
          post :create, params: { banner: valid_attributes }
        }.to change(Banner, :count).by(1)
      end

      it 'redirects to index' do
        post :create, params: { banner: valid_attributes }
        expect(response).to redirect_to(admin_banners_path)
      end
    end

    context 'with invalid parameters' do
      it 'does not create banner' do
        expect {
          post :create, params: { banner: { title: '' } }
        }.not_to change(Banner, :count)
      end

      it 'renders new template' do
        post :create, params: { banner: { title: '' } }
        expect(response).to render_template(:new)
      end
    end
  end

  describe 'DELETE #destroy' do
    it 'destroys the banner' do
      banner = create(:banner)
      expect {
        delete :destroy, params: { id: banner.id }
      }.to change(Banner, :count).by(-1)
    end
  end
end

# spec/jobs/banner_activation_job_spec.rb
require 'rails_helper'

RSpec.describe BannerActivationJob, type: :job do
  let(:banner) { create(:banner, status: :scheduled, start_date: 1.hour.ago) }

  it 'activates scheduled banner' do
    described_class.perform_now(banner.id)
    expect(banner.reload.status).to eq('active')
  end

  it 'logs activation' do
    expect(Rails.logger).to receive(:info).with(/Banner .* activated/)
    described_class.perform_now(banner.id)
  end

  it 'handles missing banner gracefully' do
    expect {
      described_class.perform_now(999999)
    }.not_to raise_error
  end
end

