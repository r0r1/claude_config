h2. Model Implementation

{code:ruby}
# app/models/banner.rb
class Banner < ApplicationRecord
  include BannerSchedulable

  # Active Storage attachment
  has_one_attached :image do |attachable|
    attachable.variant :desktop, resize_to_limit: [1920, 600]
    attachable.variant :tablet, resize_to_limit: [1024, 400]
    attachable.variant :mobile, resize_to_limit: [768, 300]
    attachable.variant :thumbnail, resize_to_limit: [300, 100]
  end

  # Enums
  enum status: {
    inactive: 'inactive',
    active: 'active',
    scheduled: 'scheduled',
    expired: 'expired'
  }

  # Validations
  validates :title, presence: true, length: { maximum: 255 }
  validates :alt_text, presence: true, length: { maximum: 255 }
  validates :placement, presence: true, inclusion: {
    in: %w[platinum_business_homepage ide_homepage toko_homepage],
    message: "%{value} is not a valid placement"
  }
  validates :priority, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
  validates :click_through_url, url: { allow_blank: true }, if: :click_through_url?
  validates :image,
            content_type: { in: ['image/png', 'image/jpg', 'image/jpeg', 'image/gif', 'image/webp'],
                          message: 'must be a valid image format' },
            size: { less_than: 2.megabytes,
                   message: 'must be less than 2MB' }
  validate :end_date_after_start_date
  validate :max_active_banners_limit

  # Scopes
  scope :active_now, -> {
    where(status: :active)
      .where('start_date IS NULL OR start_date <= ?', Time.current)
      .where('end_date IS NULL OR end_date >= ?', Time.current)
  }
  scope :for_placement, ->(placement) { where(placement: placement) }
  scope :by_priority, -> { order(priority: :desc, display_order: :asc, created_at: :desc) }
  scope :scheduled_for_activation, -> {
    where(status: :scheduled)
      .where('start_date <= ?', Time.current)
      .where('end_date IS NULL OR end_date >= ?', Time.current)
  }
  scope :scheduled_for_expiration, -> {
    where(status: :active)
      .where('end_date IS NOT NULL AND end_date < ?', Time.current)
  }

  # Callbacks
  before_validation :set_scheduled_status
  after_commit :purge_cache
  after_create :schedule_activation_job
  after_update :schedule_expiration_job, if: :saved_change_to_end_date?

  # Class methods
  def self.active_for_homepage(placement = 'platinum_business_homepage')
    active_now
      .for_placement(placement)
      .by_priority
      .limit(10)
  end

  # Instance methods
  def active_now?
    active? &&
      (start_date.nil? || start_date <= Time.current) &&
      (end_date.nil? || end_date >= Time.current)
  end

  def image_url(variant: :desktop)
    return unless image.attached?

    Rails.application.routes.url_helpers.rails_representation_url(
      image.variant(variant),
      only_path: false
    )
  end

  private

  def end_date_after_start_date
    return if start_date.blank? || end_date.blank?

    if end_date < start_date
      errors.add(:end_date, 'must be after start date')
    end
  end

  def max_active_banners_limit
    return unless active? && new_record?

    active_count = Banner.for_placement(placement).active_now.count
    if active_count >= 10
      errors.add(:base, 'Maximum 10 active banners allowed per placement')
    end
  end

  def set_scheduled_status
    if start_date.present? && start_date > Time.current
      self.status = :scheduled
    end
  end

  def purge_cache
    Rails.cache.delete(['banners', placement, 'active'])
  end

  def schedule_activation_job
    return unless scheduled? && start_date.present?

    BannerActivationJob.set(wait_until: start_date).perform_later(id)
  end

  def schedule_expiration_job
    return unless end_date.present?

    BannerExpirationJob.set(wait_until: end_date).perform_later(id)
  end
end

