# Migration 3: Create audit trail table
class CreateCustomerEmailAudits < ActiveRecord::Migration[8.0]
  def change
    create_table :customer_email_audits do |t|
      t.references :customer, null: true, foreign_key: true
      t.references :portal_user, null: false, foreign_key: true # Sales user
      t.string :email, null: false
      t.string :action, null: false # 'check', 'send', 'skip'
      t.string :result, null: false # 'existing', 'new', 'sent', 'failed'
      t.text :metadata # JSONB for additional data
      t.timestamps
