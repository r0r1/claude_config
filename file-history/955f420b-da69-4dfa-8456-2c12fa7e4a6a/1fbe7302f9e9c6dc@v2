module Customers
  class FindByEmailQuery
    attr_reader :email

    def initialize(email)
      @email = email&.strip&.downcase
    end

    def call
      return nil if email.blank?

      # Use case-insensitive search with index
      Customer
        .where('LOWER(email) = ?', email)
        .where.not(deleted_at: nil) # Exclude soft-deleted
        .first
    end
  end
end
