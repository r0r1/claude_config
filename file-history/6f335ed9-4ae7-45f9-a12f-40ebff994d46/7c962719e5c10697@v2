# Nokogiri automatically escapes XML special characters
# But we should sanitize input as defense in depth

def sanitize_for_xml(text)
  return "" if text.blank?

  text.to_s
    .gsub('&', '&amp;')
    .gsub('<', '&lt;')
    .gsub('>', '&gt;')
    .gsub('"', '&quot;')
    .gsub("'", '&apos;')
end
