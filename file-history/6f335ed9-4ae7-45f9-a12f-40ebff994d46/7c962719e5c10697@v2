## Error Handling and Logging

### Error Handling Strategy

```ruby
private

def format_street_address_1
  return "UNKNOWN" if @customer.billing_address.blank?

  begin
    address = @customer.billing_address.strip
    address = remove_building_name_from_address(address)
    truncated = smart_truncate(address, 40)

    # Log truncation events
    if address.length > 40
      Rails.logger.warn(
        "Address truncated for activation",
        {
          order_id: @order.id,
          customer_id: @customer.id,
          original_length: address.length,
          truncated_length: truncated.length
        }
      )
    end

    truncated.upcase
  rescue => e
    Rails.logger.error(
      "Error formatting street address",
      {
        error: e.message,
        backtrace: e.backtrace.first(5),
        order_id: @order.id,
        customer_id: @customer.id
      }
    )
    "UNKNOWN"
  end
end
